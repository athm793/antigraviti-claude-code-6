# Get this from https://neon.tech — create a project and copy the connection string
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require

# Required — secret key used to sign login session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this secret and stable: changing it logs out every signed-in user.
SESSION_SECRET=replace-with-a-random-64-char-hex-string
